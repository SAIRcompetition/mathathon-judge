/-
Mathathon Round 1, Problem 87: official Lean statement, prepared by AI. It may contain errors.

Written by AI for Mathathon; not taken from an existing formalization.
It states the type B analogue of Theorem 1.5 (type A) and Corollary 7.1 (type C) of
B. Dequêne, G. Frieden, A. Iraci, F. Schreier-Aigner, H. Thomas and N. Williams, "Charmed roots
and the Kroweras complement" (J. London Math. Soc. 110 (2024), arXiv:2212.14831): for every
standard Coxeter element `c` of the Weyl group `W(B_n)` there is a unique bijection
`Charm_c : NC(W, c) → NN(W)` with `Charm_c ∘ Krew_c = Krow_c ∘ Charm_c` and
`Supp ∘ Charm_c = Supp`. This is the bijection that the charmed-root construction should produce
in type B (the problem's stretch goal); that it be given by natural or local rules is not part
of the statement.

The definitions follow Sections 2–4 of that paper, specialised to type `B_n`. `W(B_n)` is the
group of permutations of `ℤⁿ` generated by the simple reflections `s_i` (for `i < n - 1`, swap
the coordinates `i` and `i + 1`; `s_{n-1}` negates the last coordinate); its reflections are the
conjugates of the `s_i`, and `NC(W, c)` is the interval `[1, c]` in absolute order. The positive
roots are `e_i - e_j`, `e_i + e_j` (`i < j`) and `e_i`, the simple roots are `e_i - e_{i+1}` and
`e_{n-1}`, and `α ≤ β` when `β - α` is a nonnegative integer combination of simple roots;
`NN(W)` is the set of order ideals. `Krow_c` toggles the inversions `α⁽¹⁾, …, α⁽ᴺ⁾` of the
`c`-sorting word of `w₀` in this order. In type `B_n` that word is the word of `c` repeated `n`
times, because `w₀ = -1 = cⁿ` and this word has length `n² = ℓ(w₀)`, so the leftmost reduced word
for `w₀` in `c^∞` is this prefix; the definition uses it directly. The support of `π ∈ W` is the
set of simple reflections needed to write `π` (the letters of any reduced word), and the support
of an order ideal is the set of simple roots in it.
-/

import Mathlib

namespace Mathathon.P87

variable (n : ℕ)

/-- Vectors of `ℤⁿ`, on which `W(B_n)` acts by signed permutations of the coordinates. -/
abbrev V := Fin n → ℤ

/-- The simple reflection `s_i`: for `i < n - 1` it swaps the coordinates `i` and `i + 1`, and
`s_{n-1}` negates the last coordinate. -/
def simpleRefl (i : Fin n) : Equiv.Perm (V n) :=
  if h : i.val + 1 < n then
    (Equiv.swap i ⟨i.val + 1, h⟩).arrowCongr (Equiv.refl ℤ)
  else
    Equiv.piCongrRight fun j => if j = i then Equiv.neg ℤ else Equiv.refl ℤ

/-- The Weyl group `W(B_n)`, generated by the simple reflections. -/
def W : Subgroup (Equiv.Perm (V n)) :=
  Subgroup.closure (Set.range (simpleRefl n))

/-- The reflections of `W(B_n)`: the conjugates of the simple reflections. -/
def reflections : Set (Equiv.Perm (V n)) :=
  {t | ∃ w ∈ W n, ∃ i, t = w * simpleRefl n i * w⁻¹}

/-- The absolute length of `w`: the least number of reflections whose product is `w`. -/
noncomputable def absLength (w : Equiv.Perm (V n)) : ℕ :=
  sInf {k | ∃ l : List (Equiv.Perm (V n)),
    l.length = k ∧ (∀ t ∈ l, t ∈ reflections n) ∧ l.prod = w}

/-- The standard Coxeter element `c = s_{σ 0} s_{σ 1} ⋯ s_{σ (n - 1)}`. -/
def coxeterElement (σ : Equiv.Perm (Fin n)) : Equiv.Perm (V n) :=
  ((List.finRange n).map fun k => simpleRefl n (σ k)).prod

/-- The noncrossing partitions `NC(W, c)`: the interval `[1, c]` of `W` in absolute order. -/
def NC (σ : Equiv.Perm (Fin n)) : Set (Equiv.Perm (V n)) :=
  {π | π ∈ W n ∧ absLength n π + absLength n (π⁻¹ * coxeterElement n σ) =
    absLength n (coxeterElement n σ)}

/-- The Kreweras complement `Krew_c π = π⁻¹ c`. -/
def krew (σ : Equiv.Perm (Fin n)) (π : Equiv.Perm (V n)) : Equiv.Perm (V n) :=
  π⁻¹ * coxeterElement n σ

/-- The support of `π`: the simple reflections needed to write `π`, that is, the `s_i` such that
`π` is not in the subgroup generated by the other simple reflections. -/
def supp (π : Equiv.Perm (V n)) : Set (Fin n) :=
  {i | π ∉ Subgroup.closure (simpleRefl n '' {j | j ≠ i})}

/-- The standard basis vector `e_i`. -/
def e (i : Fin n) : V n := Pi.single i 1

/-- The simple roots: `α_i = e_i - e_{i+1}` for `i < n - 1`, and `α_{n-1} = e_{n-1}`. -/
def simpleRoot (i : Fin n) : V n :=
  if h : i.val + 1 < n then e n i - e n ⟨i.val + 1, h⟩ else e n i

/-- The positive roots of `B_n`: `e_i - e_j` and `e_i + e_j` for `i < j`, and `e_i`. -/
def posRoots : Finset (V n) :=
  ((Finset.univ.filter fun p : Fin n × Fin n => p.1 < p.2).image
      fun p => e n p.1 - e n p.2) ∪
    ((Finset.univ.filter fun p : Fin n × Fin n => p.1 < p.2).image
      fun p => e n p.1 + e n p.2) ∪
    Finset.univ.image (e n)

/-- The order of the root poset: `α ≤ β` when `β - α` is a nonnegative integer combination of
simple roots. -/
def RootLE (α β : V n) : Prop :=
  ∃ m : Fin n → ℕ, β - α = ∑ i, (m i : ℤ) • simpleRoot n i

/-- The nonnesting partitions `NN(B_n)`: the order ideals of the positive root poset. -/
def IsNonnesting (I : Finset (V n)) : Prop :=
  I ⊆ posRoots n ∧ ∀ β ∈ I, ∀ α ∈ posRoots n, RootLE n α β → α ∈ I

/-- The support of a nonnesting partition: the simple roots in it. -/
def idealSupp (I : Finset (V n)) : Set (Fin n) :=
  {i | simpleRoot n i ∈ I}

/-- The toggle at `α`: add `α` to `I` or remove it, if the result is again an order ideal. -/
noncomputable def toggle (α : V n) (I : Finset (V n)) : Finset (V n) := by
  classical
  exact if α ∈ I then (if IsNonnesting n (I.erase α) then I.erase α else I)
    else (if IsNonnesting n (insert α I) then insert α I else I)

/-- The `c`-sorting word of `w₀`; in type `B_n` it is the word `[σ 0, …, σ (n - 1)]` of `c`
repeated `n` times. -/
def sortingWord (σ : Equiv.Perm (Fin n)) : List (Fin n) :=
  (List.replicate n ((List.finRange n).map σ)).flatten

/-- `inversionsFrom p [t₁, …, t_m] = [p (α_{t₁}), p t₁ (α_{t₂}), …, p t₁ ⋯ t_{m-1} (α_{t_m})]`. -/
def inversionsFrom : Equiv.Perm (V n) → List (Fin n) → List (V n)
  | _, [] => []
  | p, i :: w => p (simpleRoot n i) :: inversionsFrom (p * simpleRefl n i) w

/-- The inversion sequence `α⁽ᵃ⁾ = t₁ ⋯ t_{a-1} (α_{t_a})` of the `c`-sorting word
`t₁ ⋯ t_N` of `w₀`. -/
def inversions (σ : Equiv.Perm (Fin n)) : List (V n) :=
  inversionsFrom n 1 (sortingWord n σ)

/-- The Kroweras complement `Krow_c = tog_{α⁽ᴺ⁾} ∘ ⋯ ∘ tog_{α⁽¹⁾}`. -/
noncomputable def krow (σ : Equiv.Perm (Fin n)) (I : Finset (V n)) : Finset (V n) :=
  (inversions n σ).foldl (fun J α => toggle n α J) I

/-- `f` restricts to a bijection `NC(W, c) → NN(W)` with `f ∘ Krew_c = Krow_c ∘ f` and
`Supp ∘ f = Supp` on `NC(W, c)`. -/
def IsCharmBijection (σ : Equiv.Perm (Fin n)) (f : Equiv.Perm (V n) → Finset (V n)) : Prop :=
  Set.BijOn f (NC n σ) {I | IsNonnesting n I} ∧
    (∀ π ∈ NC n σ, f (krew n σ π) = krow n σ (f π)) ∧
    ∀ π ∈ NC n σ, idealSupp n (f π) = supp n π

/-- **Charmed bijection in type B.** For `n ≥ 2` and every standard Coxeter element
`c = s_{σ 0} ⋯ s_{σ (n - 1)}` of `W(B_n)`, there is a bijection `NC(W, c) → NN(W)` that
intertwines `Krew_c` and `Krow_c` and preserves support, and it is unique on `NC(W, c)`. -/
theorem exists_unique_charm_typeB (hn : 2 ≤ n) (σ : Equiv.Perm (Fin n)) :
    ∃ f, IsCharmBijection n σ f ∧
      ∀ g, IsCharmBijection n σ g → Set.EqOn g f (NC n σ) := by
  sorry

end Mathathon.P87
