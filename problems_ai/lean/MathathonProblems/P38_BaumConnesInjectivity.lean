/-
Mathathon Round 1, Problem 38: official Lean statement, prepared by AI. It may contain errors.

Written by AI for Mathathon; not taken from an existing formalization.
It states Theorem 1.1 of the OpenAI preprint "A torsion-free counterexample to reduced Baum–Connes
injectivity" (September 23, 2026, not refereed), the claimed counterexample that the problem asks
to explain: there are a finitely generated torsion-free group `G`, an injective homomorphism
`i : ℤ² → G` and a class `c ∈ H²(BG; ℤ)` with `⟨(Bi)^* c, [T²]⟩ = 1` and `i_*(β) = 0` in
`K₀(C*_r G)`, where `β` is a rank-zero Bott generator of `K₀(C*_r ℤ²)`. By the preprint, this makes
`(Bi)_*[D_{T²}]` an infinite-order class in `K₀(BG)` killed by the reduced assembly map; that
deduction (K-homology, the assembly map) is not part of the statement.

Modelling choices:
* `C*_r(G)` is the norm closure in `B(ℓ²(G))` of the *-algebra generated by the left-regular
  operators `λ_g`, `(λ_g f)(h) = f(g⁻¹ h)`; the image of `C*_r(ℤ²)` under the inclusion induced by
  `i` is the norm closure of the *-algebra generated by the `λ_{i(h)}`.
* `H²(BG; ℤ)` is the group cohomology `H²(G; ℤ)` with trivial coefficients. The condition
  `⟨(Bi)^* c, [T²]⟩ = 1` is stated as "`i^* c` generates `H²(ℤ²; ℤ) ≅ ℤ`", which also allows the
  value `-1`; precomposing `i` with the swap of the two factors of `ℤ²` changes this sign and does
  not change the image of `C*_r(ℤ²)`, so the existence statement is the same.
* `K₀(C*_r ℤ²) = K₀(C(T²))` is free on `[1]` and the rank-zero Bott class `β`, and the canonical
  trace (which `i` preserves) is `1` on `[1]` and `0` on `β`. Hence `i_*(β) = 0` is equivalent to:
  for every projection `P` in a matrix algebra over the image of `C*_r(ℤ²)`, the class of `P` in
  `K₀(C*_r G)` is a natural multiple `j [1]`. For a projection `P ∈ M_k`, `[P] = j [1]` is spelled
  out as: for some `m`, `P ⊕ 1_m` and `diag(1, …, 1, 0, …, 0) ⊕ 1_m` (with `j` ones) are
  Murray–von Neumann equivalent in `M_{k+m}(C*_r G)`.
-/

import Mathlib

namespace Mathathon.P38

open CategoryTheory
open scoped lp ENNReal

variable {G : Type} [Group G]

/-- Translating a square-summable function on `G` on the left keeps it square-summable. -/
theorem memℓp_leftTranslate (g : G) (f : ℓ²(G, ℂ)) :
    Memℓp (fun h => (f : G → ℂ) (g⁻¹ * h)) 2 := by
  have hf := lp.memℓp f
  rw [memℓp_gen_iff (by norm_num)] at hf ⊢
  exact (Equiv.mulLeft g⁻¹).summable_iff.mpr hf

/-- Left translation `(λ_g f)(h) = f(g⁻¹ h)` on `ℓ²(G)`, as a linear map. -/
noncomputable def leftTranslate (g : G) : ℓ²(G, ℂ) →ₗ[ℂ] ℓ²(G, ℂ) where
  toFun f := ⟨fun h => (f : G → ℂ) (g⁻¹ * h), memℓp_leftTranslate g f⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem norm_leftTranslate (g : G) (f : ℓ²(G, ℂ)) : ‖leftTranslate g f‖ = ‖f‖ := by
  rw [lp.norm_eq_tsum_rpow (by norm_num), lp.norm_eq_tsum_rpow (by norm_num)]
  congr 1
  exact (Equiv.mulLeft g⁻¹).tsum_eq (fun h => ‖(f : G → ℂ) h‖ ^ (2 : ℝ≥0∞).toReal)

/-- The left regular representation `λ_g` as a bounded operator on `ℓ²(G)`. -/
noncomputable def leftRegular (g : G) : ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ) :=
  (leftTranslate g).mkContinuous 1 fun f => by rw [norm_leftTranslate, one_mul]

/-- The reduced group C*-algebra `C*_r(G)`: the norm closure in `B(ℓ²(G))` of the *-algebra
generated by the operators `λ_g`. -/
noncomputable def reducedGroupCStarAlgebra (G : Type) [Group G] :
    StarSubalgebra ℂ (ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ)) :=
  (StarAlgebra.adjoin ℂ (Set.range (leftRegular (G := G)))).topologicalClosure

/-- The norm closure of the *-algebra generated by the `λ_{i(h)}`, `h ∈ H`: the image of
`C*_r(H)` in `C*_r(G)` under the inclusion induced by an injective homomorphism `i`. -/
noncomputable def imageCStarAlgebra {H : Type} [Group H] (i : H →* G) :
    StarSubalgebra ℂ (ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ)) :=
  (StarAlgebra.adjoin ℂ (Set.range fun h => leftRegular (i h))).topologicalClosure

/-- For a projection `P ∈ M_k(C*_r(G))`, `[P] = j [1]` in `K₀(C*_r(G))`: for some `m`,
`P ⊕ 1_m` and `diag(1, …, 1, 0, …, 0) ⊕ 1_m` (with `j` ones, or `k` if `j > k`) are
Murray–von Neumann equivalent in `M_{k+m}(C*_r(G))`. -/
def K0ClassEqNatMulOne {k : ℕ} (P : Matrix (Fin k) (Fin k) (ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ)))
    (j : ℕ) : Prop :=
  ∃ (m : ℕ) (v : Matrix (Fin k ⊕ Fin m) (Fin k ⊕ Fin m) (ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ))),
    (∀ a b, v a b ∈ reducedGroupCStarAlgebra G) ∧
    star v * v = Matrix.fromBlocks P 0 0 1 ∧
    v * star v = Matrix.fromBlocks (Matrix.diagonal fun a : Fin k => if (a : ℕ) < j then 1 else 0)
      0 0 1

/-- The restriction map `H²(G; ℤ) → H²(ℤ²; ℤ)` along `i : ℤ² → G` (trivial coefficients). -/
noncomputable def restrictH2 (i : Multiplicative (ℤ × ℤ) →* G) :
    groupCohomology (Rep.trivial ℤ G ℤ) 2 ⟶
      groupCohomology (Rep.trivial ℤ (Multiplicative (ℤ × ℤ)) ℤ) 2 :=
  groupCohomology.map i (𝟙 _) 2

/-- Theorem 1.1 of the preprint: a finitely generated torsion-free group `G` with an injective
homomorphism `i : ℤ² → G` and a class `c ∈ H²(G; ℤ)` restricting to a generator of `H²(ℤ²; ℤ)`,
such that `i_*` sends the rank-zero Bott class of `K₀(C*_r ℤ²)` to `0` in `K₀(C*_r G)`. -/
theorem torsion_free_counterexample :
    ∃ (G : Type) (_ : Group G), Group.FG G ∧ (∀ g : G, ∀ n : ℕ, 0 < n → g ^ n = 1 → g = 1) ∧
      ∃ i : Multiplicative (ℤ × ℤ) →* G, Function.Injective i ∧
        (∃ c : groupCohomology (Rep.trivial ℤ G ℤ) 2,
          ∀ y : groupCohomology (Rep.trivial ℤ (Multiplicative (ℤ × ℤ)) ℤ) 2,
            ∃ t : ℤ, y = t • restrictH2 i c) ∧
        ∀ (k : ℕ) (P : Matrix (Fin k) (Fin k) (ℓ²(G, ℂ) →L[ℂ] ℓ²(G, ℂ))),
          (∀ a b, P a b ∈ imageCStarAlgebra i) → IsStarProjection P →
            ∃ j : ℕ, K0ClassEqNatMulOne P j := by
  sorry

end Mathathon.P38
