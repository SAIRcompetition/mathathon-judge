/-
Mathathon Round 1, Problem 64: official Lean statement.

Written for Mathathon; not taken from an existing formalization.
It states the two theorems of the problem page. (a) Over every infinite field of positive
characteristic there is a T-ideal that is not finitely based (A. Ya. Belov, "Counterexamples
to the Specht problem", Sb. Math. 191 (2000); see also A. V. Grishin and V. V. Shchigolev,
1999). (b) Over an infinite field, a system of identities in a bounded number of variables
follows from a finite subsystem (A. R. Kemer, "Identities of finitely generated algebras over
an infinite field", Math. USSR Izv. 37 (1991): the free algebra of finite rank has the ACC on
T-ideals). As in this literature, algebras need not have a unit: polynomials live in the free
associative algebra without unit on countably many variables `x₀, x₁, …` (linear combinations
of nonempty words), and substitutions are its non-unital algebra endomorphisms.
-/

import Mathlib

namespace Mathathon.P64

variable (K : Type*) [Field K]

/-- The free associative `K`-algebra without unit on the variables `x₀, x₁, …`: finite
`K`-linear combinations of nonempty words in these variables. -/
abbrev FreeNUAlg := MonoidAlgebra K (FreeSemigroup ℕ)

/-- The variable `xᵢ`. -/
noncomputable def var (i : ℕ) : FreeNUAlg K := MonoidAlgebra.single (FreeSemigroup.of i) 1

variable {K}

/-- A T-ideal: a two-sided ideal (a `K`-subspace closed under multiplication on either side by
any polynomial) that is closed under every substitution, i.e. under every `K`-algebra
endomorphism of the free algebra. -/
def IsTIdeal (I : Submodule K (FreeNUAlg K)) : Prop :=
  (∀ a ∈ I, ∀ b : FreeNUAlg K, b * a ∈ I) ∧ (∀ a ∈ I, ∀ b : FreeNUAlg K, a * b ∈ I) ∧
    ∀ φ : FreeNUAlg K →ₙₐ[K] FreeNUAlg K, ∀ a ∈ I, φ a ∈ I

/-- The T-ideal generated by a set `S` of polynomials: the smallest T-ideal containing `S`,
i.e. the set of all identities that follow from `S`. -/
noncomputable def tIdealSpan (S : Set (FreeNUAlg K)) : Submodule K (FreeNUAlg K) :=
  sInf {I | IsTIdeal I ∧ S ⊆ I}

/-- A T-ideal is finitely based if it is generated, as a T-ideal, by finitely many
polynomials. -/
def IsFinitelyBased (I : Submodule K (FreeNUAlg K)) : Prop :=
  ∃ S : Set (FreeNUAlg K), S.Finite ∧ tIdealSpan S = I

/-- **(a) Counterexample to the Specht problem** (Belov). Over an infinite field of positive
characteristic there is a T-ideal that is not finitely based. -/
theorem exists_tIdeal_not_finitelyBased (p : ℕ) (hp : p.Prime) [CharP K p] [Infinite K] :
    ∃ I : Submodule K (FreeNUAlg K), IsTIdeal I ∧ ¬ IsFinitelyBased I := by
  sorry

/-- **(b) Local finite basis property** (Kemer). Over an infinite field, if a system `S` of
identities involves only the variables `x₀, …, x_{m-1}`, then `S` follows from a finite
subsystem. -/
theorem exists_finite_subsystem [Infinite K] (m : ℕ) (S : Set (FreeNUAlg K))
    (hS : S ⊆ NonUnitalAlgebra.adjoin K (var K '' Set.Iio m)) :
    ∃ S₀ ⊆ S, S₀.Finite ∧ tIdealSpan S₀ = tIdealSpan S := by
  sorry

end Mathathon.P64
