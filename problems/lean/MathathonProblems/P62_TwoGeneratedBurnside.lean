import Mathlib

namespace BoundedBurnsideProblem

/--
Let $G$ be a group generated by two elements, and assume there exists $n > 0$ such that for
every $g$ in $G$, $g^n = 1$. Must $G$ be finite?

The answer is negative. Novikov and Adian proved that for every odd $n \ge 4381$ the free
Burnside group $B(2, n)$ is infinite (1968); Adian later reduced this to odd $n \ge 665$
(1979). Any such group refutes the statement below.
-/
theorem two_generated_bounded_burnside_problem :
    ¬ ∀ (G : Type) [Group G] (a b : G) (gen : Subgroup.closure {a, b} = ⊤)
      (n : ℕ) (hn : n > 0) (bounded : ∀ g : G, g^n = 1), Finite G := by
  sorry

end BoundedBurnsideProblem
